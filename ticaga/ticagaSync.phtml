            <form method="post" onsubmit="return confirm('This will sync all customers. Continue?');">
                <input type="hidden" name="bulk_sync" value="1">
                <button type="submit" class="ticaga-btn ticaga-btn-primary">
                    Sync All Customers
                </button>
            </form>
            <small class="ticaga-small-text">
                Note: This only syncs active customers and includes a small delay between each to avoid overwhelming the API.
