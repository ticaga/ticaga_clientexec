    <div class="ticaga-alert <?php echo isset($syncResult['error']) ? 'error' : 'success'; ?>">
        <?php if ($syncResult['type'] === 'bulk'): ?>
            <?php if (isset($syncResult['error'])): ?>
                <strong>Bulk Sync Failed:</strong> <?php echo htmlspecialchars($syncResult['error']); ?>
            <?php else: ?>
                <strong>Bulk Sync Complete!</strong><br>
                Synced: <?php echo $syncResult['synced']; ?><br>
                Failed: <?php echo $syncResult['failed']; ?><br>
                Skipped: <?php echo $syncResult['skipped']; ?>
                
                <?php if (!empty($syncResult['errors'])): ?>
                    <hr style="margin: 10px 0;">
                    <strong>Errors:</strong>
                    <ul style="margin: 10px 0;">
                        <?php foreach (array_slice($syncResult['errors'], 0, 10) as $error): ?>
                            <li><?php echo htmlspecialchars($error); ?></li>
                        <?php endforeach; ?>
                        <?php if (count($syncResult['errors']) > 10): ?>
                            <li><em>... and <?php echo count($syncResult['errors']) - 10; ?> more errors</em></li>
                        <?php endif; ?>
                    </ul>
                <?php endif; ?>
            <?php endif; ?>
        <?php elseif ($syncResult['type'] === 'single'): ?>
            <?php if (isset($syncResult['result']['error'])): ?>
                <strong>Sync Failed for Customer #<?php echo $syncResult['customer_id']; ?>:</strong><br>
                <?php echo htmlspecialchars($syncResult['result']['error']); ?>
            <?php else: ?>
                <strong>Customer #<?php echo $syncResult['customer_id']; ?> synced successfully!</strong><br>
                Ticaga ID: <?php echo $syncResult['result']['id'] ?? 'N/A'; ?>
            <?php endif; ?>
        <?php endif; ?>
    </div>
<?php endif; ?>

