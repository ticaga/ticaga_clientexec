            <form method="post">
                <div class="ticaga-form-group" style="width: 460px !important;">
                    <label for="customer_id">Select Customer:</label>
                    <?php if (isset($customers) && is_array($customers) && count($customers) > 0): ?>
                        <select class="ticaga-form-control ticaga-customer-select" 
                                id="customer_id" 
                                name="customer_id"
                                required>
                            <option value="">-- Select a customer --</option>
                            <?php foreach ($customers as $customer): ?>
                                <option value="<?php echo htmlspecialchars($customer['id']); ?>">
                                    <?php echo htmlspecialchars($customer['display']); ?>
                                </option>
                            <?php endforeach; ?>
                        </select>
                        <small class="ticaga-small-text">
                            <?php echo count($customers); ?> customers available
                        </small>
                    <?php else: ?>
                        <select class="ticaga-form-control" id="customer_id" name="customer_id" disabled>
                            <option value="">No customers found</option>
                        </select>
                        <small class="ticaga-small-text" style="color: #dc3545;">
                            Unable to load customers. You can manually enter a customer ID instead.
                        </small>
                        <input type="number" 
                               class="ticaga-form-control" 
                               name="customer_id_manual" 
                               placeholder="Enter customer ID manually" 
                               min="1"
                               style="margin-top: 10px;">
                    <?php endif; ?>
                </div>
                <input type="hidden" name="sync_customer" value="1">
                <button type="submit" class="ticaga-btn ticaga-btn-info">
                    Sync This Customer
                </button>
            </form>
        </div>
    </div>
</div>

