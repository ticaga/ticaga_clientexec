<script>
jQuery(document).ready(function($) {
    // Select all checkbox functionality
    $('#selectAll').on('change', function() {
        $('.customer-checkbox').prop('checked', this.checked);
        updateSelectedCount();
    });
    
    // Update count when individual checkboxes change
    $('.customer-checkbox').on('change', function() {
        updateSelectedCount();
    });
    
    // Update selected count display
    function updateSelectedCount() {
        var count = $('.customer-checkbox:checked').length;
        $('#selectedCount').text(count + ' selected');
    }
    
    // Sync selected customers
    $('#syncSelectedBtn').on('click', function() {
        var selected = [];
        $('.customer-checkbox:checked').each(function() {
            selected.push($(this).val());
        });
        
        if (selected.length === 0) {
            alert('Please select at least one customer to sync.');
            return;
        }
        
        if (!confirm('Are you sure you want to sync ' + selected.length + ' customer(s)?')) {
            return;
        }
        
        // Create form and submit
        var form = $('<form>', {
            'method': 'post',
            'action': '<?php echo $this->escape($this->syncUrl ?? ''); ?>'
        });

        form.append($('<input>', {
            'type': 'hidden',
            'name': 'action',
            'value': 'ticagaSync'
        }));

        form.append($('<input>', {
            'type': 'hidden',
            'name': 'ticaga_action',
            'value': 'sync'
        }));

        form.append($('<input>', {
            'type': 'hidden',
            'name': 'bulk_sync',
            'value': '1'
        }));
        
        form.append($('<input>', {
            'type': 'hidden',
            'name': 'sessionHash',
            'value': '<?php echo $this->escape($_SESSION['hash'] ?? ''); ?>'
        }));
        
        // Add selected customer IDs
        $.each(selected, function(index, id) {
            form.append($('<input>', {
                'type': 'hidden',
                'name': 'customer_ids[]',
                'value': id
            }));
        });
        
        $('body').append(form);
        form.submit();
    });
    
    // Confirm bulk sync
    $('#bulkSyncForm').on('submit', function(e) {
        if (!confirm('Are you sure you want to sync ALL customers to Ticaga? This may take a while.')) {
            e.preventDefault();
            return false;
        }
    });
});
</script>

